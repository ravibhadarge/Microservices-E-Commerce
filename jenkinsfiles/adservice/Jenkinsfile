pipeline {
    agent any

    environment {
        GIT_REPO_NAME = "Microservices-E-Commerce"
        GIT_EMAIL = "ravibhadarge15@gmail.com"
        GIT_USER_NAME = "ravibhadarge"

        DOCKER_USERNAME = "ravibhadarge"
        IMAGE_NAME = "adservice"
        REPO_URL = "ravibhadarge/ecommerce-adservice"
        YAML_FILE = "adservice.yaml"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/ravibhadarge/Microservices-E-Commerce-eks-project.git'
            }
        }

        stage('Docker Version') {
            steps {
                sh 'docker --version'
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('src/adservice') {
                    sh '''
                        set -e
                        echo "Building ${REPO_URL}:${BUILD_NUMBER}"

                        docker build \
                          -t ${REPO_URL}:${BUILD_NUMBER} \
                          -t ${REPO_URL}:latest .
                    '''
                }
            }
        }

        stage('Docker Hub Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e
                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "Pushing ${REPO_URL}:${BUILD_NUMBER}"
                        docker push ${REPO_URL}:${BUILD_NUMBER}

                        echo "Pushing ${REPO_URL}:latest"
                        docker push ${REPO_URL}:latest

                        echo "Docker Hub push successful!"
                    '''
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('kubernetes-files') {
                    withCredentials([
                        string(
                            credentialsId: 'my-git-pattoken',
                            variable: 'git_token'
                        )
                    ]) {
                        sh '''
                            set -e

                            git config user.email "${GIT_EMAIL}"
                        git config user.name "${GIT_USER_NAME}"

                        # Push to the repo the job cloned.
                        git remote set-url origin "https://${GIT_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"
                        git fetch origin main

                        ok=0
                        for i in 1 2 3 4 5; do
                            # Sync to newest remote main FIRST -> commit is always a fast-forward.
                            git reset --hard origin/main

                            echo "Updating ${YAML_FILE}"
                            echo "Image: ${DOCKER_IMAGE}:${BUILD_NUMBER}"
                            sed -i "s#image:.*#image: ${DOCKER_IMAGE}:${BUILD_NUMBER}#g" "${YAML_FILE}"
                            git add "${YAML_FILE}"

                            if git diff --cached --quiet; then
                                echo "No deployment changes."
                                ok=1; break
                            fi

                            git commit -m "Update ${IMAGE_NAME} image to version ${BUILD_NUMBER}"
                            if git push origin HEAD:main; then
                                echo "GitHub deployment update successful!"
                                ok=1; break
                            fi

                            echo "Push rejected, re-syncing and retrying (${i}/5)..."
                            git fetch origin main
                            sleep $((RANDOM % 5 + 2))
                        done
                        [ "$ok" = "1" ] || { echo "ERROR: push failed after retries"; exit 1; }
                            fi

                            echo "GitHub deployment update successful!"
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }

        success {
            echo '=========================================='
            echo 'PIPELINE SUCCESS'
            echo 'Docker image pushed to Docker Hub'
            echo 'Kubernetes YAML updated'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED'
            echo 'Check the failed stage above.'
            echo '=========================================='
        }
    }
}
