pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'production'],
            description: 'Target environment'
        )

        choice(
            name: 'ACTION',
            choices: ['deploy', 'rollback'],
            description: 'Deployment action'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag for deployment'
        )

        string(
            name: 'ROLLBACK_TAG',
            defaultValue: '',
            description: 'Known-good Docker image tag for rollback'
        )
    }

    environment {
        REPO_URL  = 'https://github.com/ravibhadarge/Microservices-E-Commerce.git'
        CHART_DIR = 'ecommerce'
    }

    stages {

        stage('Validate Input') {
            steps {
                script {
                    if (params.ACTION == 'deploy' && !params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG is required for deploy')
                    }

                    if (params.ACTION == 'rollback' && !params.ROLLBACK_TAG?.trim()) {
                        error('ROLLBACK_TAG is required for rollback')
                    }

                    env.TARGET_TAG =
                        params.ACTION == 'deploy'
                        ? params.IMAGE_TAG.trim()
                        : params.ROLLBACK_TAG.trim()

                    env.VALUES_FILE =
                        "environments/${params.ENVIRONMENT}/values.yaml"

                    currentBuild.displayName =
                        "#${env.BUILD_NUMBER} ${params.ACTION} ${params.ENVIRONMENT} ${env.TARGET_TAG}"
                }
            }
        }

        stage('Checkout') {
            steps {
                git(
                    url: env.REPO_URL,
                    branch: 'main',
                    credentialsId: 'github-credentials'
                )
            }
        }

        stage('Helm Lint & Render') {
            steps {
                sh '''
                    set -e

                    helm lint "$CHART_DIR" \
                      -f "$VALUES_FILE" \
                      --set image.tag="$TARGET_TAG"

                    helm template ecommerce-$ENVIRONMENT "$CHART_DIR" \
                      -n "$ENVIRONMENT" \
                      -f "$VALUES_FILE" \
                      --set image.tag="$TARGET_TAG" \
                      > /tmp/ecommerce-rendered.yaml

                    echo "Helm validation successful"
                '''
            }
        }

        stage('Show Change') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "Environment : $ENVIRONMENT"
                    echo "Action      : $ACTION"
                    echo "Values file : $VALUES_FILE"
                    echo "Current tag :"
                    yq '.image.tag' "$VALUES_FILE"

                    echo "Target tag  : $TARGET_TAG"
                    echo "======================================"
                '''
            }
        }

        stage('Manual Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: """
Approve ${params.ACTION} of image ${env.TARGET_TAG}
to ${params.ENVIRONMENT}?

Environment: ${params.ENVIRONMENT}
Action:      ${params.ACTION}
Image Tag:   ${env.TARGET_TAG}
Values File: ${env.VALUES_FILE}
""",
                        ok: 'Approve Deployment'
                    )
                }
            }
        }

        stage('Update Git - GitOps') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        git config user.email "jenkins@ci.local"
                        git config user.name "jenkins"

                        echo "Updating image tag..."

                        yq -i '.image.tag = strenv(TARGET_TAG)' "$VALUES_FILE"

                        echo "New image tag:"
                        yq '.image.tag' "$VALUES_FILE"

                        git add "$VALUES_FILE"

                        git commit \
                          -m "cd(${ENVIRONMENT}): ${ACTION} ${TARGET_TAG} [build ${BUILD_NUMBER}]"

                        git push \
                          "https://${GIT_USER}:${GIT_TOKEN}@github.com/ravibhadarge/Microservices-E-Commerce.git" \
                          HEAD:main
                    '''

                    script {
                        env.DEPLOY_COMMIT =
                            sh(
                                script: 'git rev-parse HEAD',
                                returnStdout: true
                            ).trim()
                    }
                }
            }
        }

        stage('Wait for Argo CD') {
            steps {
                echo """
GitOps update completed.

Commit:
${env.DEPLOY_COMMIT}

Argo CD will detect the Git change and synchronize:
${params.ENVIRONMENT}
"""
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    sh '''
                        set +e

                        echo "Waiting for Kubernetes deployment..."

                        sleep 30

                        kubectl get namespace "$ENVIRONMENT"

                        kubectl get deployments \
                          -n "$ENVIRONMENT"

                        kubectl get pods \
                          -n "$ENVIRONMENT" \
                          -o wide

                        kubectl get services \
                          -n "$ENVIRONMENT"

                        kubectl get ingress \
                          -n "$ENVIRONMENT"

                        echo "Deployment verification completed"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo """
========================================
GITOPS DEPLOYMENT SUCCESS
========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Image Tag   : ${env.TARGET_TAG}
Commit      : ${env.DEPLOY_COMMIT}

Argo CD will keep the cluster synchronized
with Git.
========================================
"""
        }

        failure {
            echo """
========================================
GITOPS DEPLOYMENT FAILED
========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Image Tag   : ${env.TARGET_TAG}

Check the Jenkins console and Argo CD
application status.
========================================
"""
        }

        always {
            cleanWs()
        }
    }
}
