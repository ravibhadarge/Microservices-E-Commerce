// CI for currencyservice: build image -> push to Docker Hub -> write the new tag into Git (GitOps).
// Image tag = Jenkins BUILD_NUMBER of this job (run 1 -> :1, run 2 -> :2, ...).
// Argo CD watches Git and rolls the new tag out; this pipeline never touches the cluster.
pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        GIT_REPO_NAME = "Microservices-E-Commerce"
        GIT_USER_NAME = "ravibhadarge"
        GIT_EMAIL     = "ravibhadarge15@gmail.com"

        SERVICE       = "currencyservice"
        DOCKER_IMAGE  = "ravibhadarge/currencyservice"
        BUILD_CONTEXT = "src/currencyservice"
        GITOPS_ENV    = "dev"      // CI only ever updates dev; use the CD job to promote
    }

    stages {

        stage('Cleaning Workspace') {
            steps { cleanWs() }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: "https://github.com/${env.GIT_USER_NAME}/${env.GIT_REPO_NAME}.git"
            }
        }

        stage('Docker Image Build') {
            steps {
                dir(env.BUILD_CONTEXT) {
                    sh '''
                        set -e
                        echo "Building ${DOCKER_IMAGE}:${BUILD_NUMBER}"
                        docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .
                    '''
                }
            }
        }

        stage('Docker Hub Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh 'echo "$DOCKER_PASSWORD" | docker login --username "$DOCKER_USERNAME" --password-stdin'
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                sh '''
                    set -e
                    docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update GitOps Values') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GITHUB_USERNAME',
                    passwordVariable: 'GITHUB_TOKEN'
                )]) {
                    sh '''
                        set -e
                        git config user.email "${GIT_EMAIL}"
                        git config user.name  "${GIT_USER_NAME}"
                        git remote set-url origin "https://${GITHUB_USERNAME}:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"

                        # environments/dev/values.yaml  ->  services.${SERVICE}.tag = BUILD_NUMBER
                        scripts/update-image-tag.sh "${GITOPS_ENV}" "${SERVICE}=${BUILD_NUMBER}"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "${env.SERVICE}:${env.BUILD_NUMBER} pushed and written to environments/${env.GITOPS_ENV}/values.yaml - Argo CD will deploy it."
        }
        failure {
            echo 'PIPELINE FAILED - check the failed stage above.'
        }
    }
}
